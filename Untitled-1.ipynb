     "text": [
      "Giai thua cua 3 la: 6\n"
     ]
    }
   ],
   "source": [
    "\n",
    "\n",
    "def giai_thua(n):\n",
    "    if n == 0:\n",
    "        return 1\n",
    "    else:\n",
    "        return n * giai_thua(n - 1)\n",
    "\n",
    "n = int(input(\"Nhap n: \"))\n",
    "\n",
    "if n < 0:\n",
    "    print(\"n phai la so nguyen khong am\")\n",
    "else:\n",
    "    print(\"Giai thua cua\", n, \"la:\", giai_thua(n))\n"
   ]
  },
